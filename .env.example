# Copie para .env (é o arquivo que o Docker Compose e o Next leem):
#   cp .env.example .env
# .env é gitignored — nenhuma credencial vai para o repositório.

# Nome do projeto Docker Compose — governa prefixos de recurso sem depender do
# nome da pasta. Containers, volume e rede têm nome explícito (nexo-*).
COMPOSE_PROJECT_NAME=nexo

# Banco do Questor (produção, somente leitura)
QUESTOR_DB_HOST=
QUESTOR_DB_PORT=5432
QUESTOR_DB_NAME=
QUESTOR_DB_USER=
QUESTOR_DB_PASSWORD=

# Porta em que o app atende na rede: http://<ip-do-computador>:4022
# Mude se 4022 já estiver em uso na máquina de produção.
APP_PORT=4022

# Senha do banco próprio do app. É aplicada na PRIMEIRA subida, quando o volume
# é criado — trocar depois exige `docker compose down -v` (apaga os dados) ou
# um ALTER USER no banco.
APP_DB_PASSWORD=

# Conexão de DESENVOLVIMENTO com o banco próprio (publicado em 127.0.0.1:5022 —
# espelho da porta 4022 do app — pelo docker-compose.dev.yml). Use a mesma senha
# de APP_DB_PASSWORD. Dentro do compose o serviço `app` sobrescreve isto para app-db:5432.
APP_DB_URL=postgres://nexo:SENHA@localhost:5022/nexo

# ── Ajustes opcionais de runtime ─────────────────────────────────────────────
# Todos têm padrão sensato no código; defina só para sobrescrever. Vazio = padrão.
# Vida da sessão de login, em dias.
SESSAO_DIAS=30
# Pool de conexões (vale para os dois bancos): nº máx. de conexões, tempo ocioso
# até fechar (ms) e tempo máx. esperando uma conexão (ms).
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_MS=10000
# Teto por query (statement_timeout, ms). Questor lê pesado (60s); o banco do app
# grava rápido (30s).
QUESTOR_DB_STATEMENT_TIMEOUT_MS=60000
APP_DB_STATEMENT_TIMEOUT_MS=30000

# Usuário inicial do app.
# A senha só é usada para criar o usuário na primeira subida; no banco ela vai
# gravada como hash, nunca em texto puro. Se contiver # ou espaço, use aspas
# simples: ADMIN_PASSWORD='minha#senha'
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Módulo RH ─────────────────────────────────────────────────────────────────
# URL pública do app (sem barra final). Fallback quando não há requisição HTTP
# (ex.: cron sem Host). Nos envios pela tela, o link usa o host que a RH abriu
# no navegador — se o IP mudar, basta acessar pelo endereço novo ao enviar.
APP_URL=http://192.168.5.68:4022

# Envio de e-mail (SMTP) do formulário de experiência. Sem SMTP_HOST, o app só
# registra o e-mail no log do servidor (não envia) — bom para desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Segredo dos jobs do RH (/api/rh/cron/experiencia e /api/rh/cron/envios). As
# rotas só respondem com este segredo no header x-cron-secret; sem ele ficam
# desabilitadas. O serviço `scheduler` do docker-compose (nexo-scheduler) já bate
# essas rotas sozinho — experiência 1x/dia (8h) e campanhas/regras a cada 15 min —,
# então NÃO é preciso crontab no host. Se preferir o crontab do host mesmo assim:
#   0 8 * * *    curl -fsS -H "x-cron-secret: SEU_SEGREDO" http://localhost:4022/api/rh/cron/experiencia
#   */15 * * * * curl -fsS -H "x-cron-secret: SEU_SEGREDO" http://localhost:4022/api/rh/cron/envios
RH_CRON_SECRET=
# Ajustes opcionais do scheduler embutido (defaults entre parênteses):
# SCHEDULER_APP_URL=http://app:3000   # base do app na rede do compose
# SCHEDULER_ENVIOS_MIN=15             # intervalo das campanhas/regras (min)
# SCHEDULER_EXPERIENCIA_HORA=8        # hora local do disparo diário da experiência

# ── Análise de Balancete por IA (Groq, tier grátis) ──────────────────────────
# Gere a chave em https://console.groq.com → API Keys e cole aqui (formato gsk_).
# É o único ponto que gasta API, e roda sob demanda (botão "Gerar laudo escrito").
# Sigilo: antes do envio, o app censura nome e CNPJ da empresa — a IA recebe só
# o marcador [EMPRESA]; o nome real é reposto no laudo que volta.
GROQ_API_KEY=
# Modelo da análise (opcional). Padrão: llama-3.3-70b-versatile.
# Alternativa mais forte no mesmo tier grátis: openai/gpt-oss-120b.
ANALISE_MODELO=
# Endpoint OpenAI-compatível (opcional). Padrão: https://api.groq.com/openai/v1
GROQ_BASE_URL=
