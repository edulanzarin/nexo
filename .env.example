# Copie para .env (é o arquivo que o Docker Compose e o Next leem).
# .env fica fora do git: nenhuma credencial vai para o repositório.

COMPOSE_PROJECT_NAME=navex

# Banco do Questor (produção, SOMENTE LEITURA: o pool abre toda transação como read-only)
QUESTOR_DB_HOST=
QUESTOR_DB_PORT=5432
QUESTOR_DB_NAME=
QUESTOR_DB_USER=
QUESTOR_DB_PASSWORD=

# Porta em que o app atende na rede: http://<ip-da-maquina>:4083
APP_PORT=4083
# Endereço público do app, sem barra final (links de e-mail quando não há requisição).
APP_URL=http://localhost:4083

# Senha do banco próprio. Vale na PRIMEIRA subida, quando o volume nasce.
APP_DB_PASSWORD=
# Conexão de DESENVOLVIMENTO (npm run db:up publica o banco em 127.0.0.1:5083).
# Dentro do compose o app sobrescreve isto para navex-db:5432.
APP_DB_URL=postgres://navex:SENHA@localhost:5083/navex

# Ajustes opcionais (vazio = padrão do código)
SESSAO_DIAS=30
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_MS=10000
QUESTOR_DB_STATEMENT_TIMEOUT_MS=60000
APP_DB_STATEMENT_TIMEOUT_MS=30000
# Cookie de sessão com Secure: só quando houver HTTPS na frente.
COOKIE_SECURE=false

# Usuário inicial (npm run seed:admin). A senha vai para o banco como hash.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Laudo escrito da Análise de balancete (Groq, OpenAI-compatível). É o único ponto
# que gasta API e roda só no botão. O nome e o CNPJ da empresa são censurados antes.
GROQ_API_KEY=
ANALISE_MODELO=
GROQ_BASE_URL=

# Acessórias (carteira e grupos do Fechamento). Credencial de escritório.
ACESSORIAS_TOKEN=
