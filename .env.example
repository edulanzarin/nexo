# Copie para .env (é o arquivo que o Docker Compose e o Next leem).
# .env fica fora do git: nenhuma credencial vai para o repositório.

COMPOSE_PROJECT_NAME=navex

# Banco do Questor (produção, SOMENTE LEITURA: o pool abre toda transação como read-only)
QUESTOR_DB_HOST=
QUESTOR_DB_PORT=5432
QUESTOR_DB_NAME=
QUESTOR_DB_USER=
QUESTOR_DB_PASSWORD=

# Porta em que o app atende na rede: http://<ip-da-maquina>:4083
APP_PORT=4083
# Endereço público do app, sem barra final (links de e-mail quando não há requisição).
APP_URL=http://localhost:4083

# Senha do banco próprio. Vale na PRIMEIRA subida, quando o volume nasce.
APP_DB_PASSWORD=
# Conexão de DESENVOLVIMENTO (npm run db:up publica o banco em 127.0.0.1:5083).
# Dentro do compose o app sobrescreve isto para navex-db:5432.
APP_DB_URL=postgres://navex:SENHA@localhost:5083/navex

# Ajustes opcionais (vazio = padrão do código)
SESSAO_DIAS=30
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_MS=10000
QUESTOR_DB_STATEMENT_TIMEOUT_MS=60000
APP_DB_STATEMENT_TIMEOUT_MS=30000
# Fuso da sessão do banco do app (hora das telas, corte de mês). Vazio = America/Sao_Paulo.
APP_DB_TIMEZONE=
# Cookie de sessão com Secure: só quando houver HTTPS na frente.
COOKIE_SECURE=false

# Usuário inicial (npm run seed:admin). A senha vai para o banco como hash.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Laudo escrito da Análise de balancete (Groq, OpenAI-compatível). É o único ponto
# que gasta API e roda só no botão. O nome e o CNPJ da empresa são censurados antes.
GROQ_API_KEY=
ANALISE_MODELO=
GROQ_BASE_URL=

# Acessórias (carteira, grupos do Fechamento e fila do Obrigações). Credencial de escritório.
ACESSORIAS_TOKEN=

# Chave do cofre de Acessos da TI (AES-256): 32 bytes em base64. Gere uma vez com
#   docker exec navex-app node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela, nenhuma senha do cofre abre de novo,
# nem com o backup do banco. Trocar a chave deixa as senhas antigas sem abrir.
TI_COFRE_CHAVE=

# E-mail (avisos do RH e do DP). Sem SMTP_HOST o app só escreve o e-mail no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Agendador (serviço navex-scheduler). Só UM no escritório: ligar apenas no
# servidor, com COMPOSE_PROFILES=agendador. As rotas de cron só respondem com
# o segredo no header x-cron-secret.
COMPOSE_PROFILES=
RH_CRON_SECRET=
SCHEDULER_ENVIOS_MIN=15
SCHEDULER_EXPERIENCIA_HORA=8
SCHEDULER_RESCISOES_HORA=8
SCHEDULER_OBRIGACOES_HORA=5
